---
import TrustBar from './TrustBar.astro';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { siteConfig } from '../data/site-core';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';
import { getT } from '../i18n/server';
import { pubgKeywordPages } from '../data/pubg-keyword-pages';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);

const title =
	locale === defaultLocale ? pubgKeywordPages.home.h1 : t('hero.title');
const subtitle = t('hero.subtitle');
const imageAlt =
	'PUBG soldier with sniper rifle in smoky battlefield — hero background for PUBG Hack';

const chips = [
	{ key: 'chipEsp', icon: 'esp' },
	{ key: 'chipAim', icon: 'aim' },
	{ key: 'chipRadar', icon: 'radar' },
	{ key: 'chipUpdates', icon: 'updates' },
] as const;
---

<style is:inline>
	.hero-stage{position:relative}.hero{position:relative;isolation:isolate;display:grid;grid-template-areas:'hero-stack';width:100%;aspect-ratio:16/9;background:var(--bg);overflow:hidden}.hero__media,.hero__veil,.hero__content{grid-area:hero-stack}.hero__media{position:relative;z-index:0;width:100%;height:100%;overflow:hidden;line-height:0}.hero__media img{display:block;width:100%;height:100%;object-fit:cover;object-position:58% center}
</style>

<div class="hero-stage">
	<section class="hero" aria-label={title}>
		<div class="hero__media">
			<img
				class="hero__bg"
				src={heroSrc}
				srcset={heroSrcSet}
				sizes={heroSizes}
				alt={imageAlt}
				width={heroWidth}
				height={heroHeight}
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
		</div>
		<div class="hero__veil" aria-hidden="true"></div>
		<div class="shell hero__content">
			<div class="hero__copy">
				<h1 class="hero__brand">{title}</h1>
				<p class="hero__lede" data-edit="heroLede">{subtitle}</p>
				<ul class="hero__features">
					{
						chips.map((chip) => (
							<li>
								<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
									{
										chip.icon === 'esp' ? (
											<>
												<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
												<path
													d="M12 8.5v3.2L14.2 14"
													stroke="currentColor"
													stroke-width="1.6"
													stroke-linecap="round"
												/>
											</>
										) : chip.icon === 'aim' ? (
											<path
												d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linejoin="round"
											/>
										) : chip.icon === 'radar' ? (
											<>
												<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
												<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
												<path
													d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2"
													stroke="currentColor"
													stroke-width="1.6"
													stroke-linecap="round"
												/>
											</>
										) : (
											<path
												d="M5 13.2l4.2 4.2L19 7.6"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										)
									}
								</svg>
								<span data-edit={chip.key}>{t(`hero.${chip.key}`)}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
	<TrustBar locale={locale} overlay />
</div>

<style is:global>
	.hero-stage {
		position: relative;
	}

	.hero {
		--hero-pad-y: clamp(1.25rem, 2.4vw, 2rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
	}

	.hero__media,
	.hero__veil,
	.hero__content {
		grid-area: hero-stack;
	}

	.hero__media {
		position: relative;
		z-index: 0;
		width: 100%;
		height: 100%;
		min-height: 0;
		overflow: hidden;
		line-height: 0;
	}

	.hero__media img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		object-position: 58% center;
		image-rendering: auto;
		transform: translateZ(0);
		filter: brightness(0.8) contrast(1.05) saturate(1.02);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__veil {
		position: relative;
		z-index: 1;
		align-self: stretch;
		width: 100%;
		height: 100%;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--bg) 32%, transparent) 0%,
				transparent 38%,
				color-mix(in srgb, var(--bg) 38%, transparent) 100%
			),
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--bg) 94%, transparent) 0%,
				color-mix(in srgb, var(--bg) 82%, transparent) 32%,
				color-mix(in srgb, var(--bg) 52%, transparent) 48%,
				color-mix(in srgb, var(--bg) 22%, transparent) 64%,
				transparent 88%
			);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		pointer-events: none;
		padding-block: var(--hero-pad-y);
		align-self: center;
		transform: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: min(100%, 28rem);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-pubg);
		font-size: clamp(2.75rem, 6vw, 4.25rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: 0.06em;
		max-width: 100%;
		color: var(--ink-heading);
		text-transform: uppercase;
		text-wrap: balance;
		text-shadow:
			0 2px 8px rgba(0, 0, 0, 0.55),
			0 8px 28px rgba(0, 0, 0, 0.35);
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: none;
		font-size: clamp(0.95rem, 1.5vw, 1.05rem);
		line-height: 1.5;
		color: color-mix(in srgb, #fff 88%, var(--ink-muted));
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: color-mix(in srgb, #fff 85%, transparent);
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
	}

	.hero__features li span {
		min-width: 0;
	}

	.hero__features svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img {
			animation: none;
		}
	}

	@media (max-width: 900px) {
		.hero__media img {
			object-position: 62% center;
		}

		.hero__veil {
			background:
				linear-gradient(
					180deg,
					color-mix(in srgb, var(--bg) 38%, transparent) 0%,
					color-mix(in srgb, var(--bg) 62%, transparent) 40%,
					color-mix(in srgb, var(--bg) 94%, transparent) 78%,
					color-mix(in srgb, var(--bg) 98%, transparent) 100%
				),
				linear-gradient(
					90deg,
					color-mix(in srgb, var(--bg) 96%, transparent) 0%,
					color-mix(in srgb, var(--bg) 70%, transparent) 55%,
					transparent 100%
				);
		}

		.hero__content {
			align-self: end;
			min-height: 0;
		}
	}
</style>
