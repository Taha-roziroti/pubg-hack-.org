---
import PageLayout from '../layouts/PageLayout.astro';
import { pubgKeywordPages, type KeywordPageConfig } from '../data/pubg-keyword-pages';
import { siteConfig } from '../data/site';
import { AFFILIATE_REL } from '../data/affiliate';
import { getPageCrawlImage } from '../data/page-images';
import { seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';

type PageKey = keyof typeof pubgKeywordPages;

interface Props {
	pageKey: PageKey;
	pageId?: import('../data/i18n/content.generated').PageId;
}

const { pageKey, pageId } = Astro.props;
const config: KeywordPageConfig = pubgKeywordPages[pageKey];

const title = seoPageTitle(config.title);
const description = seoDescription(config.description);
const hero = getPageCrawlImage(pageId ?? 'hacks');
const heroAlt = config.imageAlt('player ESP and loot overlays');

const pageUrl = new URL(config.path, siteConfig.url).href;

function buildExtraGraph(): Record<string, unknown>[] {
	const graph: Record<string, unknown>[] = [];
	if (config.schema === 'collection-itemlist') {
		graph.push({
			'@type': 'CollectionPage',
			'@id': `${pageUrl}#collection`,
			url: pageUrl,
			name: config.h1,
			description,
			isPartOf: { '@id': `${siteConfig.url}/#website` },
		});
		graph.push({
			'@type': 'ItemList',
			'@id': `${pageUrl}#itemlist`,
			itemListElement: config.sections.map((sec, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: sec.h2,
			})),
		});
	}
	if (config.schema === 'article-itemlist') {
		graph.push({
			'@type': 'Article',
			'@id': `${pageUrl}#article`,
			headline: config.h1,
			description,
			url: pageUrl,
			isPartOf: { '@id': `${siteConfig.url}/#website` },
		});
		graph.push({
			'@type': 'ItemList',
			'@id': `${pageUrl}#itemlist`,
			itemListElement: config.sections.map((sec, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: sec.h2,
			})),
		});
	}
	if (config.schema === 'article-faq' && config.faqs?.length) {
		graph.push({
			'@type': 'Article',
			'@id': `${pageUrl}#article`,
			headline: config.h1,
			description,
			url: pageUrl,
		});
		graph.push({
			'@type': 'FAQPage',
			'@id': `${pageUrl}#faq`,
			mainEntity: config.faqs.map((f) => ({
				'@type': 'Question',
				name: f.question,
				acceptedAnswer: { '@type': 'Answer', text: f.answer },
			})),
		});
	}
	return graph;
}
---

<PageLayout
	title={title}
	description={description}
	canonicalPath={config.path}
	heading={config.h1}
	breadcrumbLabel={config.h1}
	intro={config.intro}
	heroImage={hero.src}
	heroAlt={heroAlt}
	galleryTitle="Screenshots"
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: 'Get access', edit: 'ctaBuy' }}
	showRelatedPages={false}
	pageId={pageId}
	extraGraph={buildExtraGraph()}
>
	<nav class="kw-links shell" aria-label="Related guides">
		<ul>
			{config.internalLinks.map((link) => (
				<li><a href={link.href}>{link.label}</a></li>
			))}
		</ul>
	</nav>

	<div class="kw-sections shell">
		{
			config.sections.map((section) => (
				<section class="kw-section">
					<h2>{section.h2}</h2>
					{section.paragraphs.map((p) => <p>{p}</p>)}
					{section.list ? (
						<ul>
							{section.list.map((item) => <li>{item}</li>)}
						</ul>
					) : null}
				</section>
			))
		}
	</div>

	{
		config.faqs?.length ? (
			<section class="kw-faq shell" aria-labelledby="kw-faq-title">
				<h2 id="kw-faq-title">Frequently asked questions</h2>
				{config.faqs.map((item) => (
					<details class="kw-faq__item">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</section>
		) : null
	}

	<p class="kw-cta shell">
		<a href={siteConfig.checkoutUrl} class="kw-cta__btn" rel={AFFILIATE_REL}>Get access</a>
	</p>
</PageLayout>

<style>
	.kw-links {
		padding-block: 1.25rem 0;
	}
	.kw-links ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.kw-links a {
		color: var(--link);
		font-weight: 600;
		text-decoration: none;
	}
	.kw-links a:hover {
		color: var(--accent-hover);
	}
	.kw-sections {
		padding-block: 1.5rem 2rem;
		color: var(--ink-secondary);
		line-height: 1.65;
	}
	.kw-section {
		margin-bottom: 2rem;
	}
	.kw-section h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--ink-heading);
	}
	.kw-section p {
		margin: 0 0 0.75rem;
	}
	.kw-section ul {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
	}
	.kw-faq {
		padding-bottom: 2rem;
		border-top: 1px solid var(--line-soft);
	}
	.kw-faq h2 {
		font-size: 1.25rem;
		margin: 1.5rem 0 1rem;
	}
	.kw-faq__item {
		margin-bottom: 0.75rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 0.5rem 0.75rem;
	}
	.kw-faq__item summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--ink);
	}
	.kw-faq__item p {
		margin: 0.75rem 0 0;
		color: var(--ink-muted);
	}
	.kw-cta {
		padding-bottom: 2.5rem;
	}
	.kw-cta__btn {
		display: inline-flex;
		padding: 0.65rem 1.25rem;
		background: var(--accent);
		color: var(--bg);
		font-weight: 700;
		text-decoration: none;
		border-radius: 4px;
	}
</style>
